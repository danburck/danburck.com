# Local testing for The Evening Close.
#   cp .env.example .env   then paste your key below and run: npx netlify dev
# .env is gitignored. Never commit it.

# From console.anthropic.com. Each close costs roughly 2 cents.
ANTHROPIC_API_KEY=

# Any long random string. Locally it only needs to be consistent.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=local-testing-secret-change-me-please

# Optional. Set it and creating an account requires this code.
# EVENING_CLOSE_INVITE_CODE=
