# Local testing for The Evening Close.
#   cp .env.example .env   then paste your key below and run: npx netlify dev
# .env is gitignored. Never commit it.

# From console.anthropic.com. Each close costs roughly 2 cents.
ANTHROPIC_API_KEY=

# Any long random string. Locally it only needs to be consistent.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=local-testing-secret-change-me-please

# Optional. Set it and creating an account requires this code.
# EVENING_CLOSE_INVITE_CODE=

# Sending the confirmation email. From resend.com, free tier is 3,000/month.
# Without it, sign up refuses to create accounts rather than letting
# unconfirmed people in.
RESEND_API_KEY=

# Who confirmation mail comes from. Needs a domain verified in Resend.
# EVENING_CLOSE_FROM_EMAIL=Energy Led <close@danburck.com>

# Local only. Shows the confirmation link on screen instead of emailing it,
# so you can test without a mail provider. Never set this on the live site.
EVENING_CLOSE_DEV_SHOW_LINK=1
